<?xml version="1.0" encoding="utf-8"?>
<!--
  سرویس WCF «آتیران» معمولاً روی شبکه محلی و بدون HTTPS اجرا می‌شود؛
  بنابراین ترافیک HTTP صریحاً مجاز شده است. در صورت استقرار HTTPS،
  این فایل را حذف یا محدود کنید.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
